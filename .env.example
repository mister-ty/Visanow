# Este archivo SÍ va al repositorio. El .env real NUNCA.
APP_ENV=local
APP_SECRET=                       # genera uno distinto por entorno

DB_PUERTO_HOST=5435              # 5432 lo ocupa un PostgreSQL nativo de Windows
DB_NOMBRE=visanow
DB_USUARIO=visanow
DB_PASSWORD=cambiar
DATABASE_URL=postgresql+psycopg://visanow:cambiar@localhost:5435/visanow

JWT_ALGORITMO=HS256
JWT_EXPIRA_MINUTOS=60
CORS_ORIGINS=http://localhost:5180
URL_UI=http://localhost:5180          # base de los enlaces que llegan por correo

ZONA_HORARIA=America/Bogota
MONEDA_BASE=COP

ARCHIVOS_RUTA=./almacenamiento
CIFRADO_LLAVE=                    # pasaporte y datos restringidos (RNF-04)

# Ruta a los Excel fuente. Están FUERA del repositorio a propósito:
# contienen pasaportes y credenciales de portales consulares.
DATOS_FUENTE=../02_Datos_Fuente

# --- Correo (RNF-02) -------------------------------------------------------
# Sin esto, «¿Olvidó su contraseña?» no envía nada: la petición responde igual
# -si no, delataría quién tiene cuenta- pero queda un error en el log. Mientras
# tanto la administradora restablece la contraseña desde Usuarios y entrega la
# temporal, que es la misma puerta pero atendida.
#
# Con Gmail hay que usar una «contraseña de aplicación», no la del buzón:
# https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PUERTO=587
SMTP_USUARIO=
SMTP_PASSWORD=
SMTP_DESDE=VisaNow <no-responder@visanow.co>
SMTP_TLS=true          # STARTTLS, que es lo del puerto 587
SMTP_SSL=false         # ponga true y el puerto 465 si su proveedor pide SSL directo
