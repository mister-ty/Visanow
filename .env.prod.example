# Configuración de producción. Copie este archivo a .env.prod y llénelo:
#
#     cp .env.prod.example .env.prod && chmod 600 .env.prod
#
# .env.prod NO va al repositorio (lo bloquea .gitignore) y no entra en la imagen
# de Docker (lo bloquea .dockerignore). Es el único lugar donde viven los
# secretos de producción.

# --- Base de datos -----------------------------------------------------------
# La base no se expone fuera de la red interna de Docker: solo la alcanza la API.
DB_NOMBRE=visanow
DB_USUARIO=visanow
# Genérela y no la reutilice de ningún otro sitio:
#     openssl rand -base64 32
DB_PASSWORD=

# --- Secretos de la aplicación ----------------------------------------------
# Mínimo 32 caracteres cada uno; la API no arranca si son más cortos.
#     python -c "import secrets; print(secrets.token_urlsafe(48))"
APP_SECRET=

# CIFRADO_LLAVE cifra los datos sensibles que se guardan (el número de DS-160).
#
#   GUÁRDELA TAMBIÉN FUERA DEL SERVIDOR. Si se pierde, los datos ya cifrados no
#   se pueden volver a leer: no hay forma de recuperarlos. Y si se cambia por
#   otra, lo mismo. No la rote sin un plan para re-cifrar lo guardado.
#
#     python -c "import secrets; print(secrets.token_urlsafe(48))"
CIFRADO_LLAVE=

# --- Dominios ----------------------------------------------------------------
# DOMINIO_API es el nombre que Caddy usa para pedirle el certificado a Let's
# Encrypt: tiene que existir un registro DNS «A» apuntando a la IP del servidor
# ANTES de levantar el compose, o la petición del certificado falla.
DOMINIO_API=api.sudominio.com

# URL_UI es dónde queda el frontend. Es además el único origen que la API acepta
# por CORS, así que una barra final de más deja la aplicación sin poder llamarla.
URL_UI=https://crm.sudominio.com

# --- Opcionales --------------------------------------------------------------
# Roles que no pueden entrar sin doble factor (RNF-02). Vaciarlo en producción
# deja sin segundo factor a quien ve la plata y los datos de los clientes.
MFA_ROLES_OBLIGATORIO=administradora,finanzas
